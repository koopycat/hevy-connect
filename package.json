{
  "name": "hevy-axi",
  "version": "0.1.0",
  "description": "Agent-ergonomic CLI for the Hevy Public API",
  "type": "module",
  "private": true,
  "bin": {
    "hevy-axi": "./dist/bin/hevy-axi.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/hevy-axi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api:types": "tsx scripts/generate-api-types.ts",
    "api:types:check": "tsx scripts/generate-api-types.ts --check",
    "api:sync": "tsx scripts/sync-hevy-openapi.ts",
    "api:sync:check": "tsx scripts/sync-hevy-openapi.ts --check",
    "check": "pnpm lint && pnpm format:check && pnpm api:types:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "axi-sdk-js": "^0.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.7.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.38.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.0.0"
  }
}
